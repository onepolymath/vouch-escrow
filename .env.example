# Which chain the app talks to. 56 is BNB Chain mainnet (the default), 97 is testnet.
NEXT_PUBLIC_CHAIN_ID=56

# Optional. Without these the app reads app/lib/deployments.json.
# NEXT_PUBLIC_VOUCH_ADDRESS=
# NEXT_PUBLIC_AGENT_ID_ADDRESS=
# NEXT_PUBLIC_TOKEN0_ADDRESS=
# NEXT_PUBLIC_TOKEN1_ADDRESS=
# NEXT_PUBLIC_MOCK_REGISTRY=true
# NEXT_PUBLIC_RPC_URL=

# Only the deploy script and BscScan verification need these.
# ETHERSCAN_API_KEY=
